              "raw": "{\n  \"policy\": [\n    {\n      \"namespaces\": \"<string>\",\n      \"resources\": \"skills\",\n      \"operations\": \"execute\",\n      \"metadata\": {\n        \"ullamco_1\": \"<string>\"\n      },\n      \"ttl\": \"<string>\",\n      \"rpcReqMatch\": {\n        \"tempor_47\": \"<string>\",\n        \"in_7\": \"<string>\"\n      }\n    }\n  ],\n  \"organizationId\": \"<string>\"\n}",
